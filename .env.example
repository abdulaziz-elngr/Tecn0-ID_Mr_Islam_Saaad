# Copy to .env and fill in real values. Never commit the real .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tecnoid"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional session tuning. Users stay logged in while they use the app; the
# session is only dropped after this many days with NO activity at all.
# SESSION_IDLE_DAYS=90
# SESSION_COOKIE_DAYS=365
